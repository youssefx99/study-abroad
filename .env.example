# ---------------------------------------------------------------------------
# Flow — environment template. Copy to .env and fill in.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Required for live runs. Leave blank to stay in demo mode, where every stage
# returns realistic generated output without calling any external API.
OPENAI_API_KEY=

# Set to "true" to force demo mode even when a key is present.
FLOW_DEMO_MODE=false

# Default models. Any model your key can reach will work.
FLOW_RESEARCH_MODEL=gpt-5-mini
FLOW_ANALYSIS_MODEL=gpt-5-mini
FLOW_OUTREACH_MODEL=gpt-5.1

# Service ports
GATEWAY_PORT=4000
PROFILES_PORT=4001
TARGETS_PORT=4002
PROMPTS_PORT=4003
RESEARCH_PORT=4004
ANALYSIS_PORT=4005
OUTREACH_PORT=4006
ORCHESTRATOR_PORT=4007

# Where the web app reaches the gateway (browser-visible)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Where the JSON document store lives
FLOW_DATA_DIR=./data

# Log level: debug | info | warn | error
LOG_LEVEL=info
